# GeoCopilot Environment Variables (Example Template)
# Copy this file to .env.local for local development.
# NEVER commit real credentials or secret keys to source control.

# ==============================================================================
# Supabase Configuration (Member 4 - Backend & Database Integration)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ==============================================================================
# AI & Copilot API Configuration (Member 5 - AI Workflow Planning)
# ==============================================================================
# Example endpoint or API key placeholder for AI copilot service
AI_API_ENDPOINT=https://api.example.com/v1/copilot
# OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ==============================================================================
# Geospatial / Tile Services (Member 3 - MapLibre Integration)
# ==============================================================================
# Map style URL or vector tile service key if needed
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
